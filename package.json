{
  "name": "orphic-communicator",
  "version": "1.0.2",
  "private": true,
  "description": "Guest-first browser chat and optional WebRTC calls for Orphic Realms; no account system or database required.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check app.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "socket.io": "^4.8.1"
  }
}
